# 独立部署后端时使用的 PostgreSQL 连接字符串。
DB_DSN=postgres://tano:tano_blog_pass@localhost:5431/tano_blog?sslmode=disable
# 每个 API 进程的 PostgreSQL 连接池上限与空闲连接数。
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
# 普通请求预算；上传、备份创建/下载和恢复使用较长预算（单位：秒）。
REQUEST_TIMEOUT_SECONDS=30
UPLOAD_TIMEOUT_SECONDS=1800
# 原始访问日志保留天数；0 或未设置时不自动删除历史日志。
ACCESS_LOG_RETENTION_DAYS=0
# JWT 签名密钥。上线后请保持不变，以保留现有登录会话。
JWT_SECRET=replace-with-at-least-32-random-bytes
# 初始管理员密码；首次登录后请立即修改。
ADMIN_PASSWORD=replace-with-a-strong-initial-password
# Go API 的 HTTP 监听端口。
SERVER_PORT=8080
# 上传媒体和备份归档的本地目录。
UPLOAD_DIR=./uploads
# 媒体文件大小上限（变量名沿用 MB，实际按 MiB 计算）。
UPLOAD_MAX_IMAGE_MB=50
UPLOAD_MAX_AUDIO_MB=200
UPLOAD_MAX_VIDEO_MB=2048
BACKUP_DIR=./backups
# 在跨机同步页面保存 SSH 私钥时必填。
# 使用以下命令生成一次：openssl rand -base64 32
# 主服务器和备服务器必须使用完全相同的值；切勿提交真实值到 Git。
SYNC_KEY_ENCRYPTION_KEY=
# 允许访问的浏览器来源，使用英文逗号分隔。
CORS_ORIGINS=http://localhost:3000
# 当前部署实例的公开规范 URL。
SITE_URL=http://localhost:3000
# 允许提供客户端 IP 请求头的反向代理地址或 CIDR，使用英文逗号分隔。
TRUSTED_PROXIES=127.0.0.1,::1
# Gin 运行模式：release、debug 或 test。
GIN_MODE=release
# 应用日志级别：debug、info、warn 或 error。
LOG_LEVEL=info
